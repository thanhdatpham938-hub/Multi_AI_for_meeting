LLM_PROVIDER=openai               # openai | anthropic
OPENAI_API_KEY=
# Để trống nếu dùng api.openai.com; điền khi dùng Azure/proxy tương thích OpenAI
OPENAI_BASE_URL=
MODEL_LIGHT=gpt-4.1-mini          # Agent 1, 2
MODEL_STRONG=gpt-4.1              # Agent 3, 4
LLM_TEMPERATURE=0

# Chỉ cần khi LLM_PROVIDER=anthropic (khi đó đổi MODEL_* thành claude-haiku-5-5 / claude-sonnet-5-5)
ANTHROPIC_API_KEY=
