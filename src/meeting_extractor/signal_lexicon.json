        "vậy thế này",
        "duyệt rồi",
        "duyệt luôn",
        "đã duyệt",
        {
          "re": "(?<!\\w)(?:anh|chị|em|tôi|mình) duyệt(?!\\w)",
          "display": "duyệt",
          "not_after": ["gửi", "trình", "xin", "chờ", "để", "cần", "phải"]
        },
        {
          "re": "(?<!\\w)(?:anh|chị|em|tôi) đồng ý(?!\\w)",
          "display": "đồng ý"
        }
      ],
      "suppress_phrases": [
