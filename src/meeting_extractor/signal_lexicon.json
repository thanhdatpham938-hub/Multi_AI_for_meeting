      "negators_after": ["chưa"],
      "negation_window_after": 3,
      "sentence_negation_phrases": ["không nghĩ", "chưa nên", "khó mà", "e là"],
      "rebuttal_words": ["chốt", "thống nhất", "duyệt", "quyết"],
      "condition_openers": ["nếu"]
